#!/usr/bin/env ruby
# Install an already-built fork bundle at this checkout's usual launch path, and
# make it the only Handy that starts at login.
require "fileutils"
require "json"
require "tmpdir"

ROOT = File.expand_path("..", __dir__)
USAGE = "Usage: script/install\nInstalls target/install/Handy Local.app and relaunches the fork. No backups or rebuild."
if ARGV == ["--help"] || ARGV == ["-h"]
  puts USAGE
  exit
end
abort USAGE unless ARGV.empty?
abort "This installer requires macOS." unless RUBY_PLATFORM.include?("darwin")

source = File.join(ROOT, "target/install/Handy Local.app")
bundle_id = "com.rsanheim.handy"
upstream_bundle_id = "com.pais.handy"
product = "Handy Local"
ENV["HANDY_LOCAL_BUNDLE_ID"] = bundle_id
ENV["HANDY_LOCAL_PRODUCT_NAME"] = product
verify = File.join(ROOT, "script/local-signing")
system(verify, "verify", source, exception: true)

destination = File.join(ROOT, "src-tauri/target/release/bundle/macos", "#{product}.app")
FileUtils.mkdir_p(File.dirname(destination))

# Stage and verify before quitting, so a copy failure leaves the app running.
Dir.mktmpdir(".handy-install-", File.dirname(destination)) do |stage|
  staged_app = File.join(stage, "#{product}.app")
  system("/usr/bin/ditto", source, staged_app, exception: true)
  system(verify, "verify", staged_app, exception: true)
  system("/usr/bin/osascript", "-l", "JavaScript", "-e", <<~JAVASCRIPT, exception: true)
    ObjC.import("AppKit");
    function run() {
      const apps = [];
      for (const id of ["#{bundle_id}", "#{upstream_bundle_id}"]) {
        const found = $.NSRunningApplication.runningApplicationsWithBundleIdentifier(id);
        for (let i = 0; i < found.count; i++) apps.push(found.objectAtIndex(i));
      }
      apps.forEach((app) => app.terminate);
      for (let attempt = 0; attempt < 100; attempt++) {
        if (apps.every((app) => app.isTerminated)) return;
        $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.1));
      }
      throw new Error("Handy did not quit; installation cancelled.");
    }
  JAVASCRIPT
  FileUtils.rm_r(destination) if File.exist?(destination)
  File.rename(staged_app, destination)
end

# Upstream Handy rewrites ~/Library/LaunchAgents/Handy.plist on every launch
# while its own autostart setting is on, so removing the plist alone does not
# last. Both apps are quit above, so neither can overwrite these settings.
support = File.expand_path("~/Library/Application Support")
had_settings = File.exist?(File.join(support, bundle_id, "settings_store.json"))
{ bundle_id => true, upstream_bundle_id => false }.each do |id, enabled|
  path = File.join(support, id, "settings_store.json")
  next unless File.exist?(path)
  store = JSON.parse(File.read(path))
  store.fetch("settings")["autostart_enabled"] = enabled
  File.write(path, JSON.pretty_generate(store))
end
FileUtils.rm_f(File.expand_path("~/Library/LaunchAgents/Handy.plist"))

log = File.expand_path("~/Library/Logs/#{bundle_id}/handy.log")
log_offset = File.exist?(log) ? File.size(log) : 0
system(File.join(ROOT, "script/handy"), exception: true)
puts "Installed and launched #{destination}"
abort "#{product} had no settings yet, so it cannot start at login. Turn on Launch at login in the app, or rerun script/install." unless had_settings

# Startup registers the login item and logs only when it changes or fails;
# macOS refuses it while the item is switched off in System Settings.
10.times do
  sleep 1
  startup = File.exist?(log) ? File.read(log, nil, log_offset).to_s : ""
  abort "macOS refused #{product}'s login item. Turn it on under System Settings > General > Login Items, then rerun script/install." if startup.include?("Failed to register login item")
  break if startup.include?("Registered login item")
end
puts "#{product} starts at login; upstream Handy does not."
