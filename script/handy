#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
UPSTREAM_BUNDLE_ID="com.pais.handy"
BUNDLE_ID="${HANDY_LOCAL_BUNDLE_ID:-com.rsanheim.handy}"
PRODUCT_NAME="${HANDY_LOCAL_PRODUCT_NAME:-Handy Local}"
APP_DIR="$ROOT_DIR/src-tauri/target/release/bundle/macos/$PRODUCT_NAME.app"

usage() {
  cat <<EOF
Usage: script/handy [ARGS...]

Launch the locally built $PRODUCT_NAME app through macOS Launch Services and
forward all arguments.

Examples:
  script/handy
  script/handy --debug
  script/handy --toggle-transcription
  HANDY_PERF_TRACE=1 script/handy

Hot-path trace output:
  tail -f ~/Library/Logs/$BUNDLE_ID/handy.log | grep 'perf.hot_path'

Build first if the local app is missing:
  script/local-signing all

Options handled by this launcher:
  -h, --help   Show this help.

All other arguments are passed through to $PRODUCT_NAME.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ "$BUNDLE_ID" == "$UPSTREAM_BUNDLE_ID" ]]; then
  printf 'Refusing to launch local Handy with upstream bundle identifier: %s\n' "$UPSTREAM_BUNDLE_ID" >&2
  printf 'Rebuild with the default local identity: script/local-signing all\n' >&2
  exit 1
fi

if [[ ! "$BUNDLE_ID" =~ ^[A-Za-z0-9-]+([.][A-Za-z0-9-]+)+$ ]]; then
  printf 'Invalid local bundle identifier: %s\n' "$BUNDLE_ID" >&2
  exit 1
fi

if [[ -z "$PRODUCT_NAME" || "$PRODUCT_NAME" == */* ]]; then
  printf "Invalid local product name: %s\n" "$PRODUCT_NAME" >&2
  exit 1
fi

if [[ ! -d "$APP_DIR" ]]; then
  cat >&2 <<EOF
Local Handy build not found.

Expected:
  $APP_DIR

Build it with:
  script/local-signing all
EOF
  exit 1
fi

actual_bundle_id="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$APP_DIR/Contents/Info.plist" 2>/dev/null || true)"
if [[ "$actual_bundle_id" != "$BUNDLE_ID" ]]; then
  printf '%s has unexpected bundle identifier: %s\n' "$APP_DIR" "${actual_bundle_id:-unknown}" >&2
  printf 'Expected: %s\n' "$BUNDLE_ID" >&2
  printf 'Rebuild with: script/local-signing all\n' >&2
  exit 1
fi

"$ROOT_DIR/script/local-signing" verify >/dev/null

if (($# > 0)); then
  exec /usr/bin/open -n "$APP_DIR" --args "$@"
fi

exec /usr/bin/open -n "$APP_DIR"
