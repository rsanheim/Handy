#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP_DIR="$ROOT_DIR/src-tauri/target/release/bundle/macos/Handy.app"
APP_BIN_LOWER="$APP_DIR/Contents/MacOS/handy"
APP_BIN_UPPER="$APP_DIR/Contents/MacOS/Handy"
FALLBACK_BIN="$ROOT_DIR/src-tauri/target/release/handy"

usage() {
  cat <<EOF
Usage: script/handy [ARGS...]

Launch the locally built Handy app from this checkout and forward all arguments.

Examples:
  script/handy
  script/handy --debug
  script/handy --toggle-transcription
  HANDY_PERF_TRACE=1 script/handy

Hot-path trace output:
  tail -f ~/Library/Logs/com.pais.handy/handy.log | grep 'perf.hot_path'

Build first if the local app is missing:
  script/local-signing build

Options handled by this launcher:
  -h, --help   Show this help.

All other arguments are passed through to Handy.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ -x "$APP_BIN_LOWER" ]]; then
  exec "$APP_BIN_LOWER" "$@"
elif [[ -x "$APP_BIN_UPPER" ]]; then
  exec "$APP_BIN_UPPER" "$@"
elif [[ -x "$FALLBACK_BIN" ]]; then
  exec "$FALLBACK_BIN" "$@"
fi

cat >&2 <<EOF
Local Handy build not found.

Expected one of:
  $APP_BIN_LOWER
  $APP_BIN_UPPER
  $FALLBACK_BIN

Build it with:
  script/local-signing build
EOF
exit 1
